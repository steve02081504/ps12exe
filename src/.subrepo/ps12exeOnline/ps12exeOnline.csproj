<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>ps12exeOnline</RootNamespace>
		<AssemblyName>ps12exeOnline</AssemblyName>
		<InvariantGlobalization>false</InvariantGlobalization>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<!-- build.ps1 默认把发布产物写到项目下的 publish/，避免后续 build 把它当作内容再次收集。 -->
		<DefaultItemExcludes>$(DefaultItemExcludes);publish\**;publish</DefaultItemExcludes>
		<!-- 编译服务会在运行时调用 Windows PowerShell；关闭不必要的本地化资源生成以保持发布包精简。 -->
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="scripts\compile.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
