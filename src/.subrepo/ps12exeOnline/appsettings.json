{
	"Logging": {
		"LogLevel": {
			"Default": "Information",
			"Microsoft.AspNetCore": "Warning"
		}
	},
	"AllowedHosts": "*",
	"Compiler": {
		"MaxConcurrency": 4,
		"CompileTimeoutSeconds": 90,
		"QueueTimeoutSeconds": 30,
		"MaxScriptBytes": 2097152,
		"RequestsPerMinute": 5,
		"MaxCacheBytes": 268435456,
		"CacheCleanupMinutes": 10,
		"TrustLoopback": true
	}
}
